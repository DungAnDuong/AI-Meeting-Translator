# ===== AI Meeting Translator – cấu hình máy chủ (sao chép thành server/.env) =====
# KHÔNG đặt API key trong mã nguồn frontend. Key có thể nhập trong trang Cài đặt AI
# (được mã hóa AES-256-GCM trong DB), hoặc đặt ở đây làm key mặc định cho mọi tài khoản.

# Bắt buộc ở production: chuỗi ngẫu nhiên ≥ 32 ký tự để mã hóa API key lưu trong DB.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Lưu ý: đổi APP_SECRET sẽ làm các API key đã lưu không giải mã được (cần nhập lại).
APP_SECRET=

NODE_ENV=production
PORT=8787
HOST=0.0.0.0

# Thư mục dữ liệu (file SQLite meetings.db, file âm thanh nếu người dùng bật lưu)
DATA_DIR=./data
# DB_FILE=./data/meetings.db

# Tài khoản đầu tiên luôn được phép đăng ký; các tài khoản sau chỉ khi bật cờ này.
ALLOW_REGISTRATION=false
SESSION_TTL_DAYS=14

# Tự xóa cuộc họp đã kết thúc sau N ngày (0 = giữ vô thời hạn).
RETENTION_DAYS=0

# Khi chạy sau reverse proxy (nginx, Caddy...) và/hoặc frontend ở domain khác.
TRUST_PROXY=false
# ALLOWED_ORIGINS=https://meeting.example.com

# (Tùy chọn) Key mặc định do quản trị máy chủ cấp – không bao giờ gửi về trình duyệt.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

LOG_LEVEL=info
